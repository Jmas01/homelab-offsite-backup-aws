[Unit]
Description=Encrypted off-site copy of config archive and pve-host tar to AWS S3
Wants=network-online.target mnt-pve-data.mount
After=network-online.target mnt-pve-data.mount backup-lab.service
OnFailure=notify-backup-failure@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/s3-offsite-backup.sh weekly
StandardOutput=append:/var/log/s3-offsite-backup.log
StandardError=append:/var/log/s3-offsite-backup.log
